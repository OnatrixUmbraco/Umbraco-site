@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContactPage>
@{
	Layout = "mainLayout.cshtml";
}

<section class="contact" style="Background-image:url('@(Model.BackgroundImage?.Url() ?? "")')">
	<div class="page-wrapper">
		<div class="contact-header-container">
			<h1 class=" mb-2 fw-bold contact-header" style="color:#4F5955;">@Model.BannerTitle</h1>
			@await Html.PartialAsync("Partials/static/breadcrumb", Model)
		</div>
</section>
</div>