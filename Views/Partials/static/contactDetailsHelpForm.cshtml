<div class="d-flex flex-column align-items-center justify-content-center contact-details-help-form">
    <h3 class="w-100 d-flex align-items-start">Have a question ?</h3>
    <div class="d-flex justify-content-center flex-column form-input">
        <div class="d-flex w-100 justify-content-between contact-details-help-form-upper-inputs">
            <input class="w-100" type="text" id="name" name="name" placeholder="Name" />
            <input class="w-100" type="email" id="email" name="email" placeholder="Email" />
        </div>
        <textarea placeholder="Question"></textarea>
        <button
            class="d-flex justify-content-md-center align-items-center border-0 rounded fs-6 fw-bold submit">Submit</button>
    </div>
</div>