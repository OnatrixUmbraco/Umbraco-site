@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@{
	var content = (ContentModels.Banner)Model.Content;
}

<section class="contact" style="Background-image:url('@(content.BackgroundImage?.Url() ?? "")')">
	<div class="page-wrapper">
		<div class="contact-header-container">
			<h1 class=" mb-2 fw-bold contact-header" style="color:#4F5955;">@content.BannerTitle</h1>
			@await Html.PartialAsync("Partials/static/breadcrumb", Umbraco.AssignedContentItem)
		</div>
</section>