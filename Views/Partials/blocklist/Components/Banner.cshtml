@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@{
	var content = (ContentModels.Banner)Model.Content;
}

@{
	var dynamicTitle = ViewData["ServiceTitle"] as string;
	var titleToShow = !string.IsNullOrWhiteSpace(dynamicTitle) ? dynamicTitle : content.BannerTitle;
}

<section class="contact" style="Background-image:url('@(content.BackgroundImage?.Url() ?? "")')">
	<div class="page-wrapper">
		<div class="contact-header-container">
			<h1 class="mb-2 contact-header">@titleToShow </h1>
			@await Html.PartialAsync("Partials/static/breadcrumb", Umbraco.AssignedContentItem)
		</div>
</section>