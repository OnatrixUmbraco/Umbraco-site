@using Umbraco.Cms.Core.Models
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>

@{
    var content = (ContentModels.ServiceCard)Model.Content;

    var link = content.ServiceLink?.FirstOrDefault();
    var url = link?.Url ?? "#";
}

<article class="service-card">
    <a href="@url" class="service-card-link">
        <h4 class="service-card-header">@content.ServiceCardHeader</h4>
        <div class="service-card-media">
            @if (content.ServiceCardImage != null)
            {
                <img src="@content.ServiceCardImage.Url()">
            }
        </div>
        <p class="service-card-text">@content.ServiceCardText</p>
    </a>
</article>