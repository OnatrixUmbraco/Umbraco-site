@using Umbraco.Cms.Core.Models
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>

@{
    var c = (ContentModels.ServiceCard)Model.Content;

    Link? link = c.ServiceLink?.FirstOrDefault();
    var url = link?.Url ?? "#";

    if (link != null && !string.IsNullOrWhiteSpace(link.Name))
    {
        var sep = url.Contains("?") ? "&" : "?";
        url = $"{url}{sep}title={Uri.EscapeDataString(link.Name)}";
    }
}
<article class="service-card">
    <a href="@url" class="service-card-link">
        <h4 class="service-card-header">@c.ServiceCardHeader</h4>
        <div class="service-card-media">
            @if (c.ServiceCardImage != null)
            {
                <img src="@c.ServiceCardImage.Url()" alt="">
            }
        </div>
        <p class="service-card-text">@c.ServiceCardText</p>
    </a>
</article>