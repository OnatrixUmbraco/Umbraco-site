@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@{
    var content = (ContentModels.AboutSection)Model.Content;
}

<section class="d-flex about-us">
    <div class="about-us-container">
        <p class="fw-bold about-eyebrow">
            @content.AboutEyebrow
        </p>
        <h2 class="fs-1 mt-1 about-heading">
            @content.AboutHeading
        </h2>
        <div class="fs-5 fw-light about-quote">
            @Html.Raw(content.AboutQuote)
        </div>
        <p class="mt-3 about-body">
            @content.AboutBody
        </p>
        @if (content.AboutSignatureImage != null)
        {
            <img class="mt-3" src="@content.AboutSignatureImage.Url()" alt="Signature" />
        }
        <p class="about-author">
            @content.AboutAuthor
        </p>
    </div>
    <div class="about-us-form-container">
        @await Html.PartialAsync("Partials/static/callbackForm", Model)
    </div>
</section>