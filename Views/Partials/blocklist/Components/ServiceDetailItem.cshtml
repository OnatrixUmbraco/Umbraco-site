@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Cms.Core.Models.Blocks

@{
    var content = (ContentModels.ServiceDetailItem)Model.Content;
    var aside = content.Value<BlockListModel>("asideAboutBlock");
}

<div class="d-flex align-items-start flex-column service-details-container">
    <div class="d-flex align-items-start flex-column service-details-header-container">
        <img class="service-header-image" src="@content.ServiceHeaderImage!.Url()" />
        <p class="fw-bold key-point">
            @content.KeyPointLabel
        </p>
        <div class="key-points">
            @Html.Raw(@content.KeyPoints)
        </div>
    </div>
    <div class="d-flex align-items-start flex-column service-details-header-container">
        <p class="fw-bold service-header-text">@content.ServiceHeaderText</p>
        <div class="service-body">
            @Html.Raw(@content.ServiceBody)
        </div>
        <img class="services-secondary-image" src="@content.ServiceSecondaryImage!.Url()" />
        <p class="fw-bold service-secondary-body-text">@content.ServiceSecondaryHeaderText</p>
        <div class="secondary-service-body">
            @Html.Raw(@content.SecondaryServiceBody)
        </div>
    </div>
</div>