@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<HomePage>
@{
	Layout = "mainLayout.cshtml";
}

<section class="hero" style="Background-image:url('@(Model.HeroImage?.Url() ?? "")')">
	<div class="page-wrapper">
		<div class="px-3 hero-container">
			<div class="col-d d-flex flex-column gap-4">
				<h1 class="display-2 fw-bold lh-1 hero-header" style="color:#4F5955;">
					@Model.HeroTitle</h1>
				<div class="hero-text">
					@Html.Raw(Model.HeroText)</div>
				@if (Model.HeroLink != null)
				{
					<button class="contact-us-button">
						<a class="text-white cursor-pinter fs-6 fw-bold text-decoration-none"
							href="@Model.HeroLink.Url">@Model.HeroLink.Name</a>
					</button>
				}
			</div>
		</div>
</section>
</div>